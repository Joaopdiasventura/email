{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "",
    "functions": {
        "api/main.go": {
            "maxDuration": 10
        }
    },
    "routes": [
        {
            "src": "/metrics",
            "dest": "/api/main"
        },
        {
            "src": "/(.*)",
            "dest": "/api/main"
        }
    ]
}
